{
  "schema_version": "1.0.0",
  "feature_set": {
    "$defs": {
      "Feature": {
        "additionalProperties": false,
        "description": "One recognized machining feature with measured parameters.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "type": {
            "$ref": "#/$defs/FeatureType"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "face_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Face Ids",
            "type": "array"
          },
          "params": {
            "$ref": "#/$defs/FeatureParams"
          },
          "position": {
            "anyOf": [
              {
                "$ref": "#/$defs/Vec3"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "axis": {
            "anyOf": [
              {
                "$ref": "#/$defs/Vec3"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "source": {
            "default": "rules",
            "title": "Source",
            "type": "string"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "title": "Notes",
            "type": "array"
          }
        },
        "required": [
          "id",
          "type",
          "confidence"
        ],
        "title": "Feature",
        "type": "object"
      },
      "FeatureParams": {
        "additionalProperties": false,
        "description": "Measured parameters of a feature. Only fields measured are populated.",
        "properties": {
          "diameter": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Diameter"
          },
          "inner_diameter": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Inner Diameter"
          },
          "outer_diameter": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Outer Diameter"
          },
          "depth": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Depth"
          },
          "radius": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Radius"
          },
          "length": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Length"
          },
          "width": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Width"
          },
          "height": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Height"
          },
          "angle_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Angle Deg"
          },
          "chamfer_width": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Chamfer Width"
          },
          "wall_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Wall Count"
          },
          "is_through": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Is Through"
          },
          "extra": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Extra",
            "type": "object"
          }
        },
        "title": "FeatureParams",
        "type": "object"
      },
      "FeatureType": {
        "description": "Machining feature classes recognized by BRepLens.",
        "enum": [
          "through_hole",
          "blind_hole",
          "counterbore",
          "countersink",
          "pocket",
          "slot",
          "step",
          "boss",
          "fillet",
          "chamfer",
          "unknown"
        ],
        "title": "FeatureType",
        "type": "string"
      },
      "PartSummary": {
        "additionalProperties": false,
        "description": "Cheap, serializable summary used by lists and the similarity index.",
        "properties": {
          "n_faces": {
            "default": 0,
            "title": "N Faces",
            "type": "integer"
          },
          "n_edges": {
            "default": 0,
            "title": "N Edges",
            "type": "integer"
          },
          "n_cylinders": {
            "default": 0,
            "title": "N Cylinders",
            "type": "integer"
          },
          "n_planes": {
            "default": 0,
            "title": "N Planes",
            "type": "integer"
          },
          "n_cones": {
            "default": 0,
            "title": "N Cones",
            "type": "integer"
          },
          "n_tori": {
            "default": 0,
            "title": "N Tori",
            "type": "integer"
          },
          "n_concave_edges": {
            "default": 0,
            "title": "N Concave Edges",
            "type": "integer"
          },
          "n_convex_edges": {
            "default": 0,
            "title": "N Convex Edges",
            "type": "integer"
          },
          "n_smooth_edges": {
            "default": 0,
            "title": "N Smooth Edges",
            "type": "integer"
          },
          "bbox_size": {
            "$ref": "#/$defs/Vec3"
          },
          "volume": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Volume"
          },
          "surface_area": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Surface Area"
          },
          "n_features": {
            "default": 0,
            "title": "N Features",
            "type": "integer"
          }
        },
        "title": "PartSummary",
        "type": "object"
      },
      "TimingBreakdown": {
        "additionalProperties": false,
        "description": "Per-stage wall-clock timings in milliseconds.",
        "properties": {
          "load_ms": {
            "default": 0.0,
            "title": "Load Ms",
            "type": "number"
          },
          "graph_ms": {
            "default": 0.0,
            "title": "Graph Ms",
            "type": "number"
          },
          "recognition_ms": {
            "default": 0.0,
            "title": "Recognition Ms",
            "type": "number"
          },
          "total_ms": {
            "default": 0.0,
            "title": "Total Ms",
            "type": "number"
          }
        },
        "title": "TimingBreakdown",
        "type": "object"
      },
      "Vec3": {
        "description": "A 3D vector or point in part coordinates (mm).",
        "properties": {
          "x": {
            "default": 0.0,
            "title": "X",
            "type": "number"
          },
          "y": {
            "default": 0.0,
            "title": "Y",
            "type": "number"
          },
          "z": {
            "default": 0.0,
            "title": "Z",
            "type": "number"
          }
        },
        "title": "Vec3",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Versioned output of one recognition run on one part.",
    "properties": {
      "schema_version": {
        "default": "1.0.0",
        "title": "Schema Version",
        "type": "string"
      },
      "part": {
        "default": "",
        "title": "Part",
        "type": "string"
      },
      "mode": {
        "default": "rules",
        "title": "Mode",
        "type": "string"
      },
      "created_utc": {
        "title": "Created Utc",
        "type": "string"
      },
      "features": {
        "items": {
          "$ref": "#/$defs/Feature"
        },
        "title": "Features",
        "type": "array"
      },
      "summary": {
        "$ref": "#/$defs/PartSummary"
      },
      "timings": {
        "$ref": "#/$defs/TimingBreakdown"
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      },
      "model_version": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Model Version"
      },
      "extra": {
        "additionalProperties": true,
        "title": "Extra",
        "type": "object"
      }
    },
    "title": "FeatureSet",
    "type": "object"
  },
  "part_graph": {
    "$defs": {
      "CurveType": {
        "description": "Analytic curve classes tracked for edges.",
        "enum": [
          "line",
          "circle",
          "ellipse",
          "bspline",
          "other"
        ],
        "title": "CurveType",
        "type": "string"
      },
      "EdgeConvexity": {
        "description": "Local dihedral character of an edge between two faces.",
        "enum": [
          "convex",
          "concave",
          "smooth",
          "unknown"
        ],
        "title": "EdgeConvexity",
        "type": "string"
      },
      "EdgeRecord": {
        "additionalProperties": false,
        "description": "One B-Rep edge shared by two faces, with convexity attribution.",
        "properties": {
          "id": {
            "minimum": 0,
            "title": "Id",
            "type": "integer"
          },
          "face_a": {
            "minimum": 0,
            "title": "Face A",
            "type": "integer"
          },
          "face_b": {
            "minimum": 0,
            "title": "Face B",
            "type": "integer"
          },
          "convexity": {
            "$ref": "#/$defs/EdgeConvexity"
          },
          "length": {
            "minimum": 0.0,
            "title": "Length",
            "type": "number"
          },
          "curve_type": {
            "$ref": "#/$defs/CurveType"
          },
          "midpoint": {
            "$ref": "#/$defs/Vec3"
          },
          "dihedral_angle_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Dihedral Angle Deg"
          }
        },
        "required": [
          "id",
          "face_a",
          "face_b",
          "convexity",
          "length",
          "curve_type",
          "midpoint"
        ],
        "title": "EdgeRecord",
        "type": "object"
      },
      "FaceRecord": {
        "additionalProperties": false,
        "description": "One B-Rep face, attributed for recognition and learning.",
        "properties": {
          "id": {
            "minimum": 0,
            "title": "Id",
            "type": "integer"
          },
          "surface_type": {
            "$ref": "#/$defs/SurfaceType"
          },
          "area": {
            "minimum": 0.0,
            "title": "Area",
            "type": "number"
          },
          "centroid": {
            "$ref": "#/$defs/Vec3"
          },
          "bbox_min": {
            "$ref": "#/$defs/Vec3"
          },
          "bbox_max": {
            "$ref": "#/$defs/Vec3"
          },
          "normal": {
            "anyOf": [
              {
                "$ref": "#/$defs/Vec3"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "axis_origin": {
            "anyOf": [
              {
                "$ref": "#/$defs/Vec3"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "axis_direction": {
            "anyOf": [
              {
                "$ref": "#/$defs/Vec3"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "radius": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Radius"
          },
          "secondary_radius": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Secondary Radius"
          },
          "semi_angle_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Semi Angle Deg"
          },
          "face_orientation": {
            "default": 0,
            "title": "Face Orientation",
            "type": "integer"
          },
          "material_side": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Material Side"
          },
          "step_face_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Step Face Id"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Label"
          },
          "label_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Label Id"
          }
        },
        "required": [
          "id",
          "surface_type",
          "area",
          "centroid",
          "bbox_min",
          "bbox_max"
        ],
        "title": "FaceRecord",
        "type": "object"
      },
      "PartMetadata": {
        "additionalProperties": false,
        "description": "Provenance and units for a converted part.",
        "properties": {
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          },
          "source_format": {
            "default": "step",
            "title": "Source Format",
            "type": "string"
          },
          "units": {
            "default": "mm",
            "title": "Units",
            "type": "string"
          },
          "source_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Path"
          },
          "n_faces": {
            "default": 0,
            "title": "N Faces",
            "type": "integer"
          },
          "n_edges": {
            "default": 0,
            "title": "N Edges",
            "type": "integer"
          },
          "bbox_min": {
            "$ref": "#/$defs/Vec3"
          },
          "bbox_max": {
            "$ref": "#/$defs/Vec3"
          },
          "volume": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Volume"
          },
          "n_features": {
            "default": 0,
            "title": "N Features",
            "type": "integer"
          },
          "generator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Generator"
          },
          "family": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Family"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Notes"
          }
        },
        "title": "PartMetadata",
        "type": "object"
      },
      "SurfaceType": {
        "description": "Analytic surface classes tracked by the neutral IR.",
        "enum": [
          "plane",
          "cylinder",
          "cone",
          "sphere",
          "torus",
          "bspline",
          "other"
        ],
        "title": "SurfaceType",
        "type": "string"
      },
      "Vec3": {
        "description": "A 3D vector or point in part coordinates (mm).",
        "properties": {
          "x": {
            "default": 0.0,
            "title": "X",
            "type": "number"
          },
          "y": {
            "default": 0.0,
            "title": "Y",
            "type": "number"
          },
          "z": {
            "default": 0.0,
            "title": "Z",
            "type": "number"
          }
        },
        "title": "Vec3",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Neutral Attributed Adjacency Graph for one part.",
    "properties": {
      "schema_version": {
        "default": "1.0.0",
        "title": "Schema Version",
        "type": "string"
      },
      "metadata": {
        "$ref": "#/$defs/PartMetadata"
      },
      "faces": {
        "items": {
          "$ref": "#/$defs/FaceRecord"
        },
        "title": "Faces",
        "type": "array"
      },
      "edges": {
        "items": {
          "$ref": "#/$defs/EdgeRecord"
        },
        "title": "Edges",
        "type": "array"
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      }
    },
    "title": "PartGraph",
    "type": "object"
  }
}